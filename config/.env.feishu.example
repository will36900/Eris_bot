# 飞书 Bot 环境变量模板
# 复制内容到 Hermes 工作区的 .env（通常是 ~/.hermes/.env）
# 真实值不要提交到公开仓库

# === 飞书应用凭据 ===
# 在飞书开发者后台获取：https://open.feishu.cn/app
FEISHU_APP_ID=cli_your_app_id_here
FEISHU_APP_SECRET=<your-app-secret>

# === 连接配置 ===
# 国内飞书用 feishu，国际版 Lark 用 lark
FEISHU_DOMAIN=feishu

# websocket（推荐）或 webhook
FEISHU_CONNECTION_MODE=websocket

# === 访问控制 ===
# open / allowlist / mention
FEISHU_GROUP_POLICY=open

# 允许所有用户对话；真正的高权限边界交给 owner 白名单 / 权限插件
GATEWAY_ALLOW_ALL_USERS=true

# Owner 的飞书 Open ID（形如 ou_xxx）
# 获取方式：给机器人发一条私聊，看 gateway 日志里的 sender / user_id
FEISHU_OWNER_OPEN_ID=ou_<YOUR_FEISHU_OPEN_ID>
