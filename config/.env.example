# 复制到 Hermes 工作区的 .env（通常是 ~/.hermes/.env）
# 本文件只含占位符，填好后的 .env 不要提交到任何公开仓库

# === LLM ===
# 按你实际用的提供商填写其一即可
DEEPSEEK_API_KEY=sk-your-deepseek-key
# OPENROUTER_API_KEY=sk-or-your-key
# ANTHROPIC_API_KEY=sk-ant-your-key

# === QQ 机器人 ===
# 在 QQ 开放平台创建机器人后获得：https://q.qq.com/
QQ_APP_ID=<YOUR_QQ_APP_ID>
QQ_CLIENT_SECRET=<YOUR_QQ_CLIENT_SECRET>
QQ_ALLOW_ALL_USERS=true

# Owner 的 QQ user_openid（私聊里 adapter 报上来的 source.user_id）
# 获取方式：先让 bot 跑起来，私聊发一条，看 gateway 日志里的 user_id
QQ_OWNER_OPENID=<YOUR_QQ_OWNER_OPENID>

# 要接入的群 openid（群消息事件里的 chat_id / group_openid）
QQ_GROUP_ID=<YOUR_QQ_GROUP_ID>

# === 飞书（可选，不接飞书可整段删掉）===
# 详见 config/.env.feishu.example
